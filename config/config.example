// ============================================================================
// SALES LOG PRO - CONFIGURATION EXAMPLE
// ============================================================================
//
// This file demonstrates all available configuration options for Sales Log Pro.
// Actual configuration is managed through the Settings UI in Google Sheets.
// DO NOT edit this file - it is for reference only.
//
// To configure your Sales Log Pro installation:
// 1. Open your Google Sheet
// 2. Go to Sales Log menu → Settings
// 3. Use the Settings sidebar to modify configuration
//
// All changes made through the Settings UI are stored in Google Apps Script
// Properties Service and automatically synced to the SALESPEOPLE sheet.
//
// ============================================================================

{
  "version": "1",
  
  // ========================================================================
  // SALES TEAM CONFIGURATION
  // ========================================================================
  // Define your sales team members here. Each salesperson needs:
  // - fullName: Complete name as it appears in reports (required)
  // - aliases: Comma-separated alternative names/nicknames for data entry
  // - displayCode: 2-4 character code for compact displays (required)
  //
  // Example: If a salesperson is named "John Smith" but sometimes enters
  // sales as "John" or "JS", add those as aliases for automatic matching.
  
  "salespeople": [
    {
      "fullName": "Sarah Johnson",
      "aliases": "Sarah, SJ, S Johnson",
      "displayCode": "SJ"
    },
    {
      "fullName": "Michael Chen",
      "aliases": "Mike, Michael, MC",
      "displayCode": "MC"
    },
    {
      "fullName": "Emily Rodriguez",
      "aliases": "Emily, Em, E Rod",
      "displayCode": "ER"
    },
    {
      "fullName": "David Thompson",
      "aliases": "Dave, David, DT",
      "displayCode": "DT"
    },
    {
      "fullName": "Jennifer Martinez",
      "aliases": "Jen, Jennifer, JM",
      "displayCode": "JM"
    }
  ],
  
  // ========================================================================
  // VISUAL CUSTOMIZATION
  // ========================================================================
  // Customize colors and thresholds for visual indicators in the spreadsheet.
  // All colors must be in 6-digit hex format (e.g., #FF0000 for red).
  
  "visual": {
    // Color for non-delivered deals (shown with special formatting)
    "nonDeliveredColor": "#FF0000",
    
    // Background color for cells with salesperson name errors
    "salespersonErrorColor": "#FFEBEE",
    
    // Fill color for duplicate stock number highlights
    "duplicateStockFillColor": "#b4ff0c",
    
    // Text color for duplicate stock number highlights
    "duplicateStockTextColor": "#ff0000",
    
    // Background color for leaderboard entries with zero month-to-date sales
    "leaderboardZeroMtdBgColor": "#F0F8FF",
    
    // Pace thresholds for performance indicators
    // These determine color coding in the leaderboard based on daily pace
    "paceThresholds": {
      "green": 10,   // Excellent pace (≥10 units/day) - shown in green
      "yellow": 8,   // Good pace (8-9 units/day) - shown in yellow
      "red": 0       // Needs improvement (<8 units/day) - shown in red
    }
  },
  
  // ========================================================================
  // DATE SETTINGS
  // ========================================================================
  // Configure how the system handles dates and weekends
  
  "dates": {
    // Skip Sundays when calculating selling days
    // If true, Sundays are not counted as selling days in MTD calculations
    // If false, all 7 days of the week count as selling days
    "skipSundays": true,
    
    // Monday defaults to Saturday's date
    // If true, when processing sales on Monday, the default date is Saturday
    // This is useful for entering weekend sales on Monday morning
    // If false, Monday uses Monday's date by default
    "mondayLogsSaturday": true,
    
    // Archive sheet naming format
    // Controls how monthly archive sheets are named
    // Options:
    //   "M/YY"   - Example: 1/24, 2/24, 12/24
    //   "MM/YY"  - Example: 01/24, 02/24, 12/24
    //   "MMM/YY" - Example: Jan/24, Feb/24, Dec/24
    "archiveFormat": "M/YY"
  },
  
  // ========================================================================
  // SYSTEM METADATA (Auto-generated)
  // ========================================================================
  // These fields are automatically managed by the system
  // Do not manually modify these values
  
  "lastModified": "2024-01-15T10:30:00.000Z",
  "modifiedBy": "user@example.com"
}

// ============================================================================
// CONFIGURATION NOTES
// ============================================================================
//
// SIZE LIMITS:
// - Total configuration size must be under 8KB (Google Apps Script limit)
// - Typically supports 50+ salespeople with full configuration
//
// VALIDATION:
// - All color values must be valid 6-digit hex codes (#RRGGBB)
// - Salesperson names must be 2-100 characters, letters/spaces/hyphens only
// - Display codes must be 2-4 alphanumeric characters
// - Archive format must be one of: M/YY, MM/YY, MMM/YY
//
// PERFORMANCE:
// - Configuration is cached for 10 minutes for optimal performance
// - Changes made through Settings UI take effect immediately
// - SALESPEOPLE sheet is synced automatically for backward compatibility
//
// SECURITY:
// - All inputs are sanitized to prevent XSS attacks
// - Server-side validation ensures data integrity
// - Configuration is stored per-document in Properties Service
//
// MIGRATION:
// - First-time setup automatically migrates existing SALESPEOPLE sheet data
// - Export/import functionality available for backup and migration
// - Safe to run migration multiple times (idempotent)
//
// ============================================================================